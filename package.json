{
  "name": "yannelli-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-client agent marketplace with an installable Yard MCP for just-in-time skill hydration.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli.ts serve",
    "yard": "tsx src/cli.ts",
    "adapt": "tsx src/cli.ts --adapt",
    "sync-mcp": "tsx src/cli.ts --emit-mcp",
    "build": "npm run build:server && npm run build:web",
    "build:server": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=plugins/yard/dist/cli.js --legal-comments=none",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "validate": "node scripts/validate.mjs",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "hono": "^4.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.9",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
